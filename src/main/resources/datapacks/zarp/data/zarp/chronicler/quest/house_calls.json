    {
      "text": "Get to the hospital. Front doors, if there are still doors.",
      "objectives": [
        {
          "type": "place",
          "label": "the hospital",
          "any": [
            {
              "lot": "Hospital"
            },
            {
              "structure": "#minecraft:village"
            }
          ]
        }
      ],
      "on_enter": [
        {
          "type": "npc_say",
          "text": "&7Ward C. Look for Ward C. And do not touch anything wet.",
          "radius": 16.0,
          "quest": "zarp:the_camp"
        }
      ]
    },
    {
