            "quest_item": "zarp:tissue_sample",
            "chance": 0.7
          }
        },
        {
          "type": "collect",
          "quest_item": "zarp:tissue_sample",
          "count": 3,
          "consume": false
        }
      ],
      "on_enter": [
        {
          "type": "spawn",
          "count": 5,
          "radius": 10,
          "genus": "zombiemod:harvester",
          "entity": "minecraft:zombie_villager"
        },
        {
          "type": "title",
          "title": "&cHarvesters",
          "subtitle": "&7They take pieces."
        }
      ]
    },
    {
      "text": "Ward C. The first bed. The chart is still clipped to the rail.",
      "objectives": [
        {
          "type": "kill",
          "target": [
            "zombiemod:bloater",
            "minecraft:zombie",
            "minecraft:husk",
            "minecraft:drowned",
            "minecraft:zombie_villager"
          ],
          "count": 1,
          "tag": "first_bed",
          "drop": {
            "quest_item": "zarp:origin_sample",
            "chance": 1.0
          }
        }
