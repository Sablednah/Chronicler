      "on_enter": [
        {
          "type": "spawn",
          "count": 1,
          "radius": 5,
          "genus": "zombiemod:bloater",
          "entity": "minecraft:zombie",
          "name": "&5The First Bed",
          "tag": "first_bed",
          "health": 60
        },
        {
          "type": "title",
          "title": "&5&lThe First Bed",
          "subtitle": "&7Patient one. Still here."
        }
      ],
      "on_complete": [
        {
          "type": "message",
          "text": "&dThe sample from the first bed hums in your pack. Every dead thing in the building turns its head.",
          "action_bar": false
        }
      ]
    },
    {
      "text": "The samples. Okafor wants all of them. The Enforcers on the east side would pay real money for even one.",
      "choices": [
        {
          "label": "Give Okafor everything",
          "text": "She takes them without a word, then says thank you to the samples, not to you.",
          "effects": [
            {
              "type": "reputation",
              "standing": "camp",
              "delta": 15
            },
            {
              "type": "karma",
              "delta": 5
            },
            {
              "type": "flag",
              "name": "zarp_samples_shared",
              "player": true,
              "value": true
            },
            {
              "type": "npc_say",
              "text": "&7This is it. This is where it started. I can work with this.",
              "radius": 16.0,
              "quest": "zarp:the_camp"
            }
          ]
        },
        {
          "label": "Sell one to the Enforcers",
          "text": "The money is real. So is the look Okafor gives the empty slot in the tray.",
          "effects": [
            {
              "type": "money",
              "amount": 150
            },
            {
              "type": "reputation",
              "standing": "camp",
              "delta": -10
            },
            {
              "type": "karma",
              "delta": -10
            },
            {
              "type": "flag",
              "name": "zarp_sold_sample",
              "player": true,
              "value": true
            }
          ]
        }
      ]
