{
  "name": "House Calls",
  "description": "The voice on the radio came from the hospital. So, Okafor is fairly sure, did the first case.",
  "chapter": "zarp:hospital",
  "order": 1,
  "requires": [
    "zarp:the_signal"
  ],
  "giver": {
    "type": "npc",
    "name": "-",
    "of": "zarp:the_camp"
  },
