          "count": 3
        }
      ],
      "on_enter": [
        {
          "type": "spawn",
          "count": 3,
          "radius": 8,
          "entity": "minecraft:zombie"
        },
        {
          "type": "title",
          "title": "&cThey heard you",
          "subtitle": "&7Three of them. For now."
        }
      ],
      "on_complete": [
        {
          "type": "message",
          "text": "&7Quiet again. Somewhere nearby there is a fire, and people around it. Find the camp.",
          "action_bar": false
        }
      ]
    }
